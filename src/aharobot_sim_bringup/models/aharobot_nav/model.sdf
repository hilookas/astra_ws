<?xml version="1.0"?>
<sdf version="1.8">
  <model name="aharobot">
    <pose>0 0 0.09 0 0 0</pose>
    <link name="base_footprint">
      <inertial>
        <mass>25.0</mass>
        <inertia>
          <ixx>0.55</ixx><iyy>0.65</iyy><izz>0.75</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry><box><size>0.50 0.44 0.28</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry><box><size>0.50 0.44 0.28</size></box></geometry>
        <material><ambient>0.12 0.22 0.48 1</ambient><diffuse>0.16 0.32 0.72 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.20 0 0.43 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0.05 0.24 0 1.5708 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose>0.05 -0.24 0 1.5708 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <link name="rear_caster">
      <pose>-0.20 0 -0.04 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual>
    </link>

    <joint name="left_wheel_joint" type="revolute"><parent>base_footprint</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="right_wheel_joint" type="revolute"><parent>base_footprint</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="rear_caster_joint" type="ball"><parent>base_footprint</parent><child>rear_caster</child></joint>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.48</wheel_separation><wheel_radius>0.09</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.8</max_linear_acceleration><min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration><min_angular_acceleration>-1.5</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity><min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity><min_angular_velocity>-1.2</min_angular_velocity>
    </plugin>
  </model>
</sdf>
