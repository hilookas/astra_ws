<?xml version="1.0"?>
<sdf version="1.8">
  <world name="nav_test">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction><diffuse>0.8 0.8 0.8 1</diffuse></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>10 10 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 10 0.1</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
    <model name="north_wall"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8.1 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8.1 0.1 1</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8.1 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8.1 0.1 1</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 8.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 8.1 1</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 8.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 8.1 1</size></box></geometry></visual></link></model>
    <model name="box_a"><static>true</static><pose>1.2 1.4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.8 0.8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 0.8 1</size></box></geometry><material><ambient>0.65 0.2 0.15 1</ambient><diffuse>0.65 0.2 0.15 1</diffuse></material></visual></link></model>
    <model name="box_b"><static>true</static><pose>-1.5 -1.2 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.7 1.4 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 1.4 1</size></box></geometry><material><ambient>0.2 0.55 0.2 1</ambient><diffuse>0.2 0.55 0.2 1</diffuse></material></visual></link></model>
    <include><uri>model://aharobot_nav</uri></include>
  </world>
</sdf>
